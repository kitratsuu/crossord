generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CLIENT
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(CLIENT)
  posts     Post[]
  createdAt DateTime @default(now())
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String?
  service   String?
  message   String
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
}

model Post {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  content   String
  published Boolean  @default(false)
  author    User?    @relation(fields: [authorId], references: [id])
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}